# =============================================================================
# Local development environment for libredesk-business-api.
# Copy to .env and fill in real values. .env is gitignored.
#
# In production these variables come from the parent libredesk compose's env_file;
# this file exists only so the service runs locally outside Docker.
# =============================================================================

HUB_API_BIND=127.0.0.1
HUB_API_PORT=8091

# Minimum 24 characters. Generate with: openssl rand -hex 32
HUB_API_KEY=dev-only-key-change-me-0000000000000000

# Origin allowlist (comma-separated IPs or CIDRs). The service refuses to start if this
# is empty, malformed, or 0.0.0.0/0.
HUB_ALLOWED_IPS=127.0.0.1

# Must match the Secret field of the webhook configured in LibreDesk.
# Empty means /hooks/libredesk rejects every delivery.
HUB_LIBREDESK_WEBHOOK_SECRET=

# --- LibreDesk PostgreSQL ----------------------------------------------------
# Running outside Docker, reach the published port on localhost.
# With compose.dev.yaml the db is mapped to 127.0.0.1:5432.
HUB_DB_HOST=127.0.0.1
HUB_DB_PORT=5432
HUB_DB_NAME=libredesk
HUB_DB_USER=libredesk
HUB_DB_PASSWORD=

# --- Official LibreDesk API --------------------------------------------------
# Outside Docker the app is published on the dev port (compose.dev.yaml -> 8090).
HUB_LIBREDESK_API_URL=http://127.0.0.1:8090
HUB_LIBREDESK_API_KEY=
HUB_LIBREDESK_API_SECRET=
