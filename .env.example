# =============================================================================
# Local development environment for libredesk-business-api.
# Copy to .env and fill in real values. .env is gitignored.
#
# In production these variables come from the parent libredesk compose's env_file;
# this file exists only so the service runs locally outside Docker.
#
# FAIL-CLOSED: si una variable obligatoria falta o esta mal formada, el proceso
# NO arranca. Es deliberado: preferible un despliegue que no sube a un servicio
# que clasifica o publica con configuracion parcial.
# =============================================================================

HUB_API_BIND=127.0.0.1
HUB_API_PORT=8091

# Minimum 24 characters. Generate with: openssl rand -hex 32
HUB_API_KEY=dev-only-key-change-me-0000000000000000

# Origin allowlist (comma-separated IPs or CIDRs). The service refuses to start if this
# is empty, malformed, or 0.0.0.0/0.
# LibreDesk entrega los webhooks desde dentro de libredesk-network, asi que el origen
# visible es la direccion del bridge (172.28.0.x), no la LAN. Descubrila con
# GET /meta/whoami.
HUB_ALLOWED_IPS=127.0.0.1

# Must match the Secret field of the webhook configured in LibreDesk.
# Empty means /hooks/libredesk rejects every delivery.
HUB_LIBREDESK_WEBHOOK_SECRET=

# --- LibreDesk PostgreSQL ----------------------------------------------------
# Running outside Docker, reach the published port on localhost.
# With compose.dev.yaml the db is mapped to 127.0.0.1:5432.
HUB_DB_HOST=127.0.0.1
HUB_DB_PORT=5432
HUB_DB_NAME=libredesk
HUB_DB_USER=libredesk
HUB_DB_PASSWORD=

# --- Official LibreDesk API --------------------------------------------------
# Outside Docker the app is published on the dev port (compose.dev.yaml -> 8090).
# Se usa para leer las instrucciones del asistente y para generar/publicar.
# Autenticacion: Authorization: token <key>:<secret>. La key se genera en
# Admin -> perfil del agente, o POST /api/v1/agents/{id}/api-key.
HUB_LIBREDESK_API_URL=http://127.0.0.1:8090
HUB_LIBREDESK_API_KEY=
HUB_LIBREDESK_API_SECRET=

# --- Reglas (rules/*.yaml) ---------------------------------------------------
# Directorio de los YAML. Se leen UNA vez al arrancar y se validan completo:
# cambiar una regla exige reiniciar el servicio. El hash de lo cargado se ve en
# GET /meta/config (requiere HUB_API_KEY); /healthz sigue sin datos.
# Relativo al CWD del proceso: en el contenedor es /app, y COPY app ./app del
# Dockerfile NO incluye rules/, asi que hay que anadirlo al build.
# Rule set directory (prompts.yaml + agents.yaml + prompt-augmenter.md).
# Relative to the process CWD (/app in the container). Convention:
#   rules/example  documented reference, never loaded by a running service
#   rules/dev      this workstation's live set (gitignored)
#   rules/prod     reviewed production policy
# Set de reglas activo. rules/example es el default versionado; rules/dev es local
# (gitignored) y requiere que cada estacion copie sus propios YAML antes de arrancar;
# produccion usa rules/prod, fijado en compose.prod.yaml.
PROMPT_AUGMENTER_RULE_PATH=rules/example

# --- Clasificador JEV (TypeSafe servido por OpenRouter) ----------------------
# OBLIGATORIO: sin CLASSIFIER_API_KEY el servicio no arranca.
#
# ATENCION con la URL: JEIV es un modelo de decisiones y OpenRouter RECHAZA
# chat/completions para el ("is a decisions model and cannot be used with the
# chat/completions endpoint"). No es la misma ruta que nemotron. Verificado:
#   POST https://openrouter.ai/api/alpha/decisions  -> 200
# Respuesta esperada: answers.<id>.{choice, confidence, probabilities}.
CLASSIFIER_URL=https://openrouter.ai/api/alpha/decisions
# En este stack es la MISMA llave de OpenRouter que usa LibreDesk para su
# proveedor de completion (OPENAI_API_KEY en el .env del proyecto LibreDesk).
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=typesafe/jev-1.14

# Log del payload EXACTO que se envia a JEV antes de cada clasificacion (INFO).
# Responde "que le preguntamos a JEV en este mensaje" sin leer codigo.
# APAGADO por defecto porque `state` contiene la conversacion del cliente: dato
# personal que no debe caer a los logs salvo que lo busques. Prender solo para
# depurar, y tratar los logs resultantes como sensibles.
CLASSIFIER_LOG_REQUEST=false

# Sin CLASSIFIER_TEMPERATURE / _REASONING_EFFORT / _MAX_TOKENS a proposito:
# GET /api/v1/models/typesafe/jev-1.14/endpoints devuelve supported_parameters: [].
# Enviarlos no produce error; OpenRouter los ignora en silencio. Configurarlos
# seria deuda invisible.

# prompt_key de LibreDesk usado para GENERAR la correccion. El endpoint
# /api/v1/ai/completion exige que la clave exista en ai_prompts (si no: 400
# "Template not found", verificado). Una instalacion nueva solo trae los 6 de
# fabrica; ninguno dice "corrige esta respuesta", asi que lo ideal es crear uno
# propio en Admin -> AI -> Editor prompts y poner aqui su key.
# make_professional devolvio data:"" en una prueba real (capricho del modelo);
# add_empathy y fix_grammar_spelling respondieron texto usable.
JEV_COMPLETION_PROMPT_KEY=add_empathy

# --- Controles del enforcement loop ------------------------------------------
# Dos umbrales, no uno. `confidence` mide cuanto apunta la distribucion, NO la
# probabilidad de la opcion elegida. Medido con datos reales sobre criterios de
# Koiosoft: eleccion close-forward-human con probabilidad 0.37 devolvio
# confidence 0.16 (ambiguedad legitima entre tres acciones). Con un unico umbral
# de 0.7 la feature solo cazaria casos evidentes.
JEV_MIN_CONFIDENCE=0.5
JEV_MIN_PROBABILITY=0.45

# Tope de correcciones por conversacion. Evita que una conversacion larga
# acumule correcciones indefinidas (cada una cuesta JEV + LLM).
JEV_MAX_CORRECTIONS=3

# Trabajos de pipeline simultaneos (asyncio.Semaphore). Cada trabajo espera red:
# JEV ~300ms medidos y /api/v1/ai/completion segundos. Este numero es el freno
# contra agotar la cuota del proveedor en una rafaga de mensajes del agente.
JEV_CONCURRENCY=4

# --- Corrector multi-accion (experimental, opt-in) ----------------------------
# JEV devuelve probabilidad para TODAS las opciones, no solo la ganadora (forma
# verificada contra /api/alpha/decisions). Con JEV_MULTI_ACTION=true, las opciones
# secundarias acompanan a la elegida dentro del bloque ACCION mientras su masa
# acumulada no supere el techo. `none` nunca participa: significa "no publicar" y
# contradice cualquier accion. Los textos se ordenan de menor a mayor
# probabilidad, asi la elegida (la mas fuerte) queda ultima y manda por posicion
# (G6). Default false = una sola accion, el comportamiento calibrado.
JEV_MULTI_ACTION=false
# Techo de masa acumulada en (0,1]. Se agrega mientras el total NO lo alcance;
# la ultima adicion puede pasarse un poco porque el chequeo es previo a sumar.
JEV_MULTI_PROB_CEILING=0.6
