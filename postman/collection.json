    {
      "name": "70 Webhooks entrantes (firma HMAC)",
      "item": [
        {
          "name": "70a evento válido message.created",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{HUB_URL}}/hooks/libredesk",
              "host": [
                "{{HUB_URL}}"
              ],
              "path": [
                "hooks",
                "libredesk"
              ],
              "query": []
            },
            "description": "Nota privada de asistente IA: private=true + meta.ai_assistant_id. El pre-request calcula la firma sobre el body crudo.",
            "body": {
              "mode": "raw",
              "raw": "{\"event\": \"message.created\", \"timestamp\": \"{{$isoTimestamp}}\", \"payload\": {\"uuid\": \"ae2b1323-23e2-494c-a843-96454548d3a6\", \"conversation_uuid\": \"{{CONV_UUID}}\", \"type\": \"outgoing\", \"sender_type\": \"agent\", \"private\": true, \"meta\": {\"ai_assistant_id\": 1}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": "\n// Firma X-Libredesk-Signature sobre el body CRUDO, igual que LibreDesk.\nconst crypto = require('crypto-js');\nconst raw = pm.request.body ? pm.request.body.raw : '';\nconst digest = crypto.HmacSHA256(raw, pm.environment.get('WEBHOOK_SECRET')).toString(crypto.enc.Hex);\npm.request.headers.add({ key: 'X-Libredesk-Signature', value: 'sha256=' + digest });\n"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 aceptado', () => pm.response.to.have.status(202));",
                  "pm.test('accepted', () => pm.expect(pm.response.json().status).to.oneOf(['accepted','duplicate_ignored']));"
                ]
              }
            }
          ]
        },
